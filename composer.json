{
  "name": "memran/marwa-module",
  "description": "Framework-agnostic, PSR-11 friendly module management library for PHP apps (Marwa ecosystem compatible).",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "php",
    "modules",
    "psr-11",
    "discovery",
    "marwa"
  ],
  "authors": [
    {
      "name": "Mohammad Emran",
      "email": "memran.dhk@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "source": "https://github.com/memran/marwa-module",
    "issues": "https://github.com/memran/marwa-module/issues"
  },
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.2",
    "memran/marwa-entity": "dev-main",
    "memran/marwa-support": "^1.2.1",
    "psr/container": "^1.1 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Marwa\\Module\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Marwa\\Module\\Tests\\": "tests/",
      "Marwa\\Module\\Tests\\Fixtures\\": "tests/Fixtures/modules/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:coverage": "XDEBUG_MODE=coverage php vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-clover coverage/clover.xml",
    "analyse": "php vendor/bin/phpstan analyse --configuration phpstan.neon.dist --no-progress --debug --memory-limit=512M",
    "lint": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --using-cache=no --sequential --allow-unsupported-php-version=yes",
    "fix": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no --sequential --allow-unsupported-php-version=yes",
    "ci": [
      "@test",
      "@analyse",
      "@lint"
    ]
  }
}
