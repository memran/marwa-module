{
  "name": "memran/marwa-module",
  "description": "Framework-agnostic, PSR-11 friendly module management library for PHP apps (Marwa ecosystem compatible).",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohammad Emran",
      "email": "memran.dhk@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "psr/container": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Marwa\\Module\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Marwa\\Module\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "memran/php-testify": "^1.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "php vendor/bin/testify"
  }
}
